<Project Sdk="Microsoft.NET.Sdk">

  <!-- No FiveM dependency here: the domain logic and the database layer are tested on plain .NET.
       netstandard2.0 is what FXServer's Mono runtime can load, which caps EF Core at 3.1. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>GtawMechanic.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="3.1.32" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
