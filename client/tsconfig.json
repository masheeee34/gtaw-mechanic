{
  // Type-checks the plain JS client against the official native declarations (@citizenfx/client),
  // so a misspelled native or a wrong argument count fails `npm run typecheck` instead of failing in game.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["@citizenfx/client"]
  },
  "include": ["src/**/*.js"]
}
