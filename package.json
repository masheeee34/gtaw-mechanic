{
  "name": "gtaw-mechanic",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:web && npm run build:client && npm run build:server",
    "build:web": "vite build web",
    "build:client": "node client/build.mjs",
    "build:server": "dotnet build server/GtawMechanic.Server -c Release",
    "dev:web": "vite web",
    "watch": "node scripts/watch.mjs",
    "watch:client": "node client/build.mjs --watch",
    "watch:web": "vite build web --watch",
    "typecheck": "tsc -p web && tsc -p client",
    "test": "npm run test:js && npm run test:server",
    "test:js": "vitest run",
    "test:server": "dotnet test server/GtawMechanic.Tests"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@citizenfx/client": "^2.0.38343-1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
